plugin.tx_comsolitsuggest {
  view {
    templateRootPath = {$plugin.tx_comsolitsuggest.view.templateRootPath}
    partialRootPath = {$plugin.tx_comsolitsuggest.view.partialRootPath}
    layoutRootPath = {$plugin.tx_comsolitsuggest.view.layoutRootPath}
  }

  persistence {
    storagePid = {$plugin.tx_comsolitsuggest.persistence.storagePid}
  }

  features {
    # uncomment the following line to enable the new Property Mapper.
    # rewrittenPropertyMapper = 1

    # Disable the use of a valid cHash for cached and uncached Extbase actions according to:
    # https://docs.typo3.org/typo3cms/extensions/core/8.7/Changelog/8.5/Breaking-78002-EnforceCHashArgumentForExtbaseActions.html
    requireCHashArgumentForActionArguments = 0
  }

  settings {
    limit = {$plugin.tx_comsolitsuggest.settings.limit}
    minLength = {$plugin.tx_comsolitsuggest.settings.minLength}
    includeJquery = {$plugin.tx_comsolitsuggest.settings.includeJquery}
    searchPid = {$plugin.tx_comsolitsuggest.settings.searchPid}
  }
}

# page for ajaxcall
ajaxCall = PAGE
ajaxCall {
  typeNum = 999
  config {
    disableAllHeaderCode = 1
    disablePrefixComment = 1
    metaCharset = utf-8
    xhtml_cleaning = 0
    admPanel = 0
    additionalHeaders = Content-type: application/json
    debug = 0
    no_cache = 0
  }

  100 = COA
  100 < tt_content.comsolitsuggest_suggest.20
}

// add setti ngs for data attributes to indexed search
// templates typeahead field needs to be extended like this:
// data="{suggest-url: '{f:uri.page(pageType: settings.suggestTypeNum, noCache: \'1\', )}', suggest-limit: settings.limit, suggest-min-length: settings.minLength}"
plugin.tx_indexedsearch.settings {
  limit = {$plugin.tx_comsolitsuggest.settings.limit}
  minLength = {$plugin.tx_comsolitsuggest.settings.minLength}
  suggestTypeNum < ajaxCall.typeNum
}

page {
  includeJSLibs {
    jquery = EXT:comsolit_suggest/Resources/Public/bower_components/jquery/dist/jquery.min.js
    jquery {
      if.isTrue = {$plugin.tx_comsolitsuggest.settings.includeJquery}
    }
  }

  includeJSFooter {
    typeahead = EXT:comsolit_suggest/Resources/Public/bower_components/typeahead.js/dist/typeahead.bundle_mod.js
    suggest = EXT:comsolit_suggest/Resources/Public/JavaScript/suggest.js
  }

  includeCSS {
    suggest = EXT:comsolit_suggest/Resources/Public/Css/suggest.css
  }
}

plugin.tx_comsolit_suggest = USER
plugin.tx_comsolit_suggest {
  userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
  pluginName = Suggest
  extensionName = ComsolitSuggest
  vendorName = Comsolit
  controller = Query
  action = suggest
  htmlSpecialChars = 1
  switchableControllerActions {
    Query {
      1 = suggest
    }
  }

  view =< plugin.tx_comsolitsuggest.view
  persistence =< plugin.tx_comsolitsuggest.persistence
}
